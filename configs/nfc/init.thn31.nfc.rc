# This file needs to be executed by vendor_init at boot of the device,
# in normal and FM mode.

# For factory mode, nfcstackp to create the socket as vendor here
on early-boot
    mkdir /data/vendor/nfc_socket 0770 nfc nfc
    mkdir /data/vendor 0777 nfc nfc
    mkdir /data/vendor/nfc 0777 nfc nfc
    mkdir /data/vendor/nfc/param 0777 nfc nfc
    chmod 0660 /dev/tms_nfc
    chown nfc nfc /dev/tms_nfc
    chmod 0664 /proc/tmsdev/shutdown
    chown nfc nfc /proc/tmsdev/shutdown
    chown nfc nfc /sys/nfc/chip_name

    # ktm: Load NFC firmware dynamically to /data/vendor/nfc
    copy /odm/etc/nfc/libnfc-tms.conf_24851 /data/vendor/nfc/libnfc-tms.conf
    copy /odm/etc/nfc/libnfc-tms_RF_EC2.conf_24851 /data/vendor/nfc/libnfc-tms_RF_EC2.conf
    copy /odm/etc/nfc/libnfc-tmsTransit.conf_24851 /data/vendor/nfc/libnfc-tmsTransit.conf
    copy /odm/etc/nfc/SEC_THN31_FW_VTP.txt.bin_thn31_fw_D1_1C_00 /data/vendor/nfc/SEC_THN31_FW_VTP.txt.bin
    chown nfc nfc /data/vendor/nfc/SEC_THN31_FW_VTP.txt.bin
    chown nfc nfc /data/vendor/nfc/libnfc-tms.conf
    chown nfc nfc /data/vendor/nfc/libnfc-tmsTransit.conf
    chown nfc nfc /data/vendor/nfc/libnfc-tms_RF_EC2.conf
    chmod 600 /data/vendor/nfc/SEC_THN31_FW_VTP.txt.bin
    chmod 600 /data/vendor/nfc/libnfc-tms.conf
    chmod 600 /data/vendor/nfc/libnfc-tmsTransit.conf
    chmod 600 /data/vendor/nfc/libnfc-tms_RF_EC2.conf